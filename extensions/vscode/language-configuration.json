{
  "comments": { "lineComment": "#", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [{ "open": "(", "close": ")" }, { "open": "[", "close": "]" }, { "open": "{", "close": "}" }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": { "increaseIndentPattern": "^\\s*(?:(?:if|elif|else|while|for|button|on)\\b.*\\bdo\\.|(?:public\\s+)?function\\b.*\\.)\\s*(?:#.*)?$", "decreaseIndentPattern": "^\\s*(?:end\\b|elif\\b|else\\b)" }
}
